# Copy to .env.local and fill in. Only the Firebase + Resend blocks are needed
# to run the site locally; the rest gate individual features and fail soft.

# --- Firebase (required) ---
# Client SDK — safe to expose, these ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK — the entire service-account JSON on one line, quoted.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# --- Email (required for RSVPs, speaker replies, coworking inquiries) ---
RESEND_API_KEY=
COWORKING_INQUIRY_OPS_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=

# --- One-time admin bootstrap (see README) ---
ADMIN_SETUP_SECRET=

# --- Shop: Stripe + Printify (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PRINTIFY_TOKEN=
PRINTIFY_SHOP_ID=

# --- Discord + LinkedIn syndication (optional) ---
DISCORD_BOT_BASE_URL=
DISCORD_EVENTS_WEBHOOK_URL=
DISCORD_JOBS_WEBHOOK_URL=
DISCORD_NEWS_WEBHOOK_URL=
DISCORD_YOUTUBE_WEBHOOK_URL=
STATUS_API_TOKEN=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_ID=

# --- Vercel cron auth (production only) ---
CRON_SECRET=

# Note: Vercel BotID needs no keys. It is wired through next.config.ts and
# instrumentation-client.ts, and always reports "human" in local dev.
