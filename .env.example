# Copy to .env.local and fill in. Only the Firebase + Resend blocks are needed
# to run the site locally; the rest gate individual features and fail soft.

# --- Firebase (required) ---
# Client SDK — safe to expose, these ship to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin SDK — the entire service-account JSON on one line, quoted.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# --- Email: RSVPs, speaker and volunteer forms, Get Involved, access requests, admin sign-in, donation thank-yous ---
RESEND_API_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=

# --- One-time admin bootstrap (see README) ---
ADMIN_SETUP_SECRET=

# --- Donations: Stripe (optional) ---
# The webhook secret verifies /api/donate/webhook, which sends the thank-you email.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Uploads: Vercel Blob (optional) ---
# Logo uploads in the admin. Vercel sets this when a Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# --- Discord webhooks (optional) ---
# Webhook for the #community-calendar channel, used by the Monday events
# digest cron (/api/events/weekly-digest). Without it the cron runs, reports
# success and posts nothing — see lib/discord.ts.
DISCORD_EVENTS_WEBHOOK_URL=
# Weekday prompts (/api/discord/prompts): question of the day and polls go to
# #vibe-chat, Build-and-tell Friday to #build-and-tell. Each fails soft unset.
DISCORD_VIBE_WEBHOOK_URL=
DISCORD_BUILD_WEBHOOK_URL=

# --- Vercel cron auth (production only) ---
CRON_SECRET=

# Note: Vercel BotID needs no keys. It is wired through next.config.ts and
# instrumentation-client.ts, and always reports "human" in local dev.
