{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:feed:*)",
      "Bash(node_modules/.bin/tsc --noEmit)",
      "Bash(node_modules/.bin/eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",

      "Bash(curl -s http://localhost:3000/*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:3000/*)",
      "Bash(lsof -nP -iTCP:3000 -sTCP:LISTEN)",
      "Bash(lsof -nP -iTCP:3100 -sTCP:LISTEN)",
      "Bash(pkill -f \"next dev\")",
      "Bash(pkill -f \"next-server\")",

      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:firebase.google.com)",
      "WebFetch(domain:resend.com)",
      "WebFetch(domain:docs.stripe.com)",
      "WebFetch(domain:motion.dev)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:www.devsa.community)"
    ]
  }
}
